{
  "version": 1,
  "fps": 30,
  "chapters": [
    {
      "id": "explain",
      "title": "从一组到几组",
      "shots": [
        {
          "id": "one-group",
          "title": "先看一组",
          "cue": "每组有 2 个圆片",
          "groups": 1,
          "each": 2,
          "formula": "1 个 2",
          "text": "先看这一组，里面有两个圆片。先记住，每组有几个。"
        },
        {
          "id": "two-groups",
          "title": "再来一组",
          "cue": "每组仍然是 2 个",
          "groups": 2,
          "each": 2,
          "formula": "2 + 2 = 4",
          "text": "再来同样的一组。现在是两个二相加，一共有四个圆片。"
        },
        {
          "id": "three-groups",
          "title": "三组同样多",
          "cue": "3 个 2 相加",
          "groups": 3,
          "each": 2,
          "formula": "2 + 2 + 2 = 6",
          "text": "现在有三组，每组都是两个。三个二相加，二加二再加二，等于六。"
        }
      ]
    },
    {
      "id": "reason",
      "title": "乘法为什么更方便",
      "shots": [
        {
          "id": "shorter",
          "title": "把重复相加写得短一点",
          "cue": "乘法表示几个相同加数的和",
          "groups": 3,
          "each": 2,
          "formula": "2 + 2 + 2 = 2 × 3 = 6",
          "text": "每组数量相同，就可以用乘法表示。三个二相加，可以写成二乘三，等于六。"
        },
        {
          "id": "meaning",
          "title": "两个数，各告诉我们什么",
          "cue": "每组 2 个，有 3 组",
          "groups": 3,
          "each": 2,
          "formula": "2 × 3",
          "text": "看，二告诉我们每组有两个，三告诉我们有三组。别只背算式，要能说出图里的几个几。"
        },
        {
          "id": "unequal",
          "title": "每组同样多，很重要",
          "cue": "这三组能看作 3 个 2 吗？",
          "groups": 3,
          "each": 2,
          "groupSizes": [2, 3, 2],
          "formula": "2 + 3 + 2",
          "text": "换一幅图，中间这组有三个。每组不一样多，就不能把它说成三个二。先看清每组有几个。"
        }
      ]
    },
    {
      "id": "recap",
      "title": "把乘法带到生活中",
      "shots": [
        {
          "id": "remember-groups",
          "title": "说清楚几个几",
          "cue": "每组几个 → 有几组 → 一共几个",
          "groups": 3,
          "each": 2,
          "formula": "2 × 3 = 6",
          "text": "今天记住三件事，每组有几个，有几组，一共有几个。乘法可以帮我们表示几个相同加数的和。"
        },
        {
          "id": "new-groups",
          "title": "换一幅图，也会解释",
          "cue": "每组 3 个，有 4 组",
          "groups": 4,
          "each": 3,
          "formula": "3 × 4 = 12",
          "text": "如果每组有三个，有这样的四组，就是四个三相加，三乘四等于十二。你能用家里的小物品摆一摆吗？"
        }
      ]
    }
  ]
}
